<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Sessions.Core\Sessions.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Allows restore/build on non-Windows hosts; no effect on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Per-monitor DPI awareness (PerMonitorV2) declared in the manifest. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Icon for the built exe and the taskbar -->
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Also embedded as a resource so the window chrome can show it -->
    <Resource Include="app.ico" />
  </ItemGroup>

</Project>
