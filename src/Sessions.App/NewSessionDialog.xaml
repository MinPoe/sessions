<Window x:Class="Sessions.App.NewSessionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Sessions.App"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Title="New Session" Height="600" Width="520" MinWidth="420" MinHeight="420"
        Background="{DynamicResource SurfaceBrush}"
        FontFamily="{StaticResource UIFont}" FontSize="{StaticResource FontSizeBody}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Name -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Session name" Style="{StaticResource SecondaryText}" Margin="2,0,0,6"/>
            <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="14" Padding="10,8" MinHeight="34"
                     BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                     AutomationProperties.Name="Session name"/>
            <TextBlock Text="{Binding NameError}" Foreground="{DynamicResource DestructiveBrush}"
                       FontSize="12" Margin="2,6,0,0" TextWrapping="Wrap"
                       Visibility="{Binding HasNameError, Converter={StaticResource BoolToVisibility}}"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="Choose windows to capture"
                   Style="{StaticResource SecondaryText}" Margin="2,0,0,8"/>

        <!-- Window checklist -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <ListBox ItemsSource="{Binding Windows}" BorderThickness="0" Background="Transparent"
                         HorizontalContentAlignment="Stretch" Padding="4"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Open windows"
                         Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:WindowRow}">
                            <Border Padding="8,8" Margin="2,1" CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              IsEnabled="{Binding IsSupported}"
                                              AutomationProperties.Name="{Binding Title}"/>

                                    <Grid Grid.Column="1" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Border Background="{DynamicResource BadgeBrush}" CornerRadius="5"
                                                Visibility="{Binding Icon, Converter={StaticResource NullToVisibility}}"/>
                                        <Image Source="{Binding Icon}" Width="24" Height="24"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Reason}" Style="{StaticResource SecondaryText}"
                                                   FontSize="11" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding Reason, Converter={StaticResource NotNullToVisibility}}"/>
                                    </StackPanel>

                                    <Border Grid.Column="3" Style="{StaticResource Badge}" Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding Adapter, Converter={StaticResource NotNullToVisibility}}">
                                        <TextBlock Text="{Binding Adapter}" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Loading -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                    <ProgressBar IsIndeterminate="True" Width="160" Height="4" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="Looking for open windows…" Style="{StaticResource SecondaryText}"
                               Margin="0,10,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Failures (shown after a partial capture) -->
        <Border Grid.Row="3" Margin="0,12,0,0" Padding="12" CornerRadius="8"
                Background="{DynamicResource WarnPanelBrush}" BorderBrush="{DynamicResource WarnPanelBorderBrush}" BorderThickness="1"
                Visibility="{Binding HasFailures, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="Some windows weren't captured:" FontWeight="Medium"
                           Foreground="{DynamicResource DestructiveBrush}" Margin="0,0,0,4"/>
                <ItemsControl ItemsSource="{Binding Failures}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource SecondaryText}"
                                       FontSize="12" Margin="0,2,0,0"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Actions -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" MinWidth="88" Margin="0,0,10,0"
                    IsCancel="True" Click="OnCancel" AutomationProperties.Name="Cancel"/>
            <Button x:Name="PrimaryActionButton" Content="Save" Style="{StaticResource PrimaryButton}" MinWidth="100"
                    IsDefault="True" Command="{Binding SaveCommand}" AutomationProperties.Name="Save session"/>
        </StackPanel>
    </Grid>
</Window>
