<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light appearance, keys match DarkColors.xaml exactly so the two swap cleanly -->
    <SolidColorBrush x:Key="WindowBrush" Color="#FFF5F5F7"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#FFF5F5F7"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#FFE2E2E6"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#FFD2D2D7"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF1D1D1F"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF6E6E73"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF0A84FF"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF2A95FF"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF0060DF"/>
    <SolidColorBrush x:Key="DestructiveBrush" Color="#FFD70015"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#11000000"/>
    <SolidColorBrush x:Key="BadgeBrush" Color="#FFEDEDF0"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#FFF2F2F4"/>
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#FFE8E8EC"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF1E8E3E"/>
    <SolidColorBrush x:Key="WarnPanelBrush" Color="#FFFDF0F0"/>
    <SolidColorBrush x:Key="WarnPanelBorderBrush" Color="#FFF3C9C9"/>

</ResourceDictionary>
