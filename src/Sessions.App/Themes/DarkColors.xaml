<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark appearance, semantic keys mirror LightColors.xaml -->
    <SolidColorBrush x:Key="WindowBrush" Color="#FF1C1C1E"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FF2C2C2E"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#FF232325"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#FF3A3A3C"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#FF48484A"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF5F5F7"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF98989D"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF0A84FF"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF409CFF"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF0060DF"/>
    <SolidColorBrush x:Key="DestructiveBrush" Color="#FFFF453A"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#18FFFFFF"/>
    <SolidColorBrush x:Key="BadgeBrush" Color="#FF3A3A3C"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#FF3A3A3C"/>
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#FF48484A"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF30D158"/>
    <SolidColorBrush x:Key="WarnPanelBrush" Color="#FF3A2A2C"/>
    <SolidColorBrush x:Key="WarnPanelBorderBrush" Color="#FF5A3A3C"/>

</ResourceDictionary>
