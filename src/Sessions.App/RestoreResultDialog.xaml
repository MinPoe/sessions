<Window x:Class="Sessions.App.RestoreResultDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Sessions.App"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Title="Load Session" Height="480" Width="460" MinWidth="380" MinHeight="320"
        Background="{DynamicResource SurfaceBrush}"
        FontFamily="{StaticResource UIFont}" FontSize="{StaticResource FontSizeBody}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="HeaderBlock" Style="{StaticResource TitleText}" FontSize="17"/>
            <TextBlock x:Name="SummaryBlock" Style="{StaticResource SecondaryText}" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" CornerRadius="8">
            <ListBox ItemsSource="{Binding}" BorderThickness="0" Background="Transparent" Padding="4"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Restore results">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:RestoreRow}">
                        <Grid Margin="6,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Border Background="{DynamicResource BadgeBrush}" CornerRadius="6"
                                        Visibility="{Binding Icon, Converter={StaticResource NullToVisibility}}"/>
                                <Image Source="{Binding Icon}" Width="28" Height="28"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>

                            <TextBlock Grid.Column="1" Text="{Binding Glyph}" FontSize="15" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="0,0,10,0" MinWidth="16"
                                       TextAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource DestructiveBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Success}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="Medium"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource SecondaryText}"
                                           FontSize="12" Margin="0,1,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Button Grid.Row="2" Content="Done" Style="{StaticResource PrimaryButton}"
                HorizontalAlignment="Right" MinWidth="100" Margin="0,18,0,0"
                IsDefault="True" IsCancel="True" Click="OnDone" AutomationProperties.Name="Done"/>
    </Grid>
</Window>
